[Unit]
Description=Mount 'vault - immich' directory with gocryptfs
After=server_sshfs_mount_vault.service
BindsTo=server_sshfs_mount_vault.service
ConditionPathIsDirectory=${STORAGE_GOCRYPTFS_MOUNT_IMMICH:-${SERVER_PATH}/storage/mount/gocryptfs/immich}
ConditionPathExists=${STORAGE_GOCRYPTFS_KEYS_PATH:-${SERVER_PATH}/storage/.keys}/immich.key

[Service]
Type=forking
NotifyAccess=all

User=${STORAGE_UID:-0}
Group=${STORAGE_GID:-0}

ExecStartPre=-/usr/bin/fusermount -u -q ${STORAGE_GOCRYPTFS_MOUNT_IMMICH:-${SERVER_PATH}/storage/mount/gocryptfs/immich}
ExecStart=/usr/bin/gocryptfs -allow_other -rw -nodev -exec -passfile ${STORAGE_GOCRYPTFS_KEYS_PATH:-${SERVER_PATH}/storage/.keys}/immich.key ${STORAGE_SSH_MOUNT_VAULT:-${SERVER_PATH}/storage/mount/sshfs/vault}/gocryptfs/immich.crypt ${STORAGE_GOCRYPTFS_MOUNT_IMMICH:-${SERVER_PATH}/storage/mount/gocryptfs/immich}

ExecStop=/usr/bin/fusermount -u ${STORAGE_GOCRYPTFS_MOUNT_IMMICH:-${SERVER_PATH}/storage/mount/gocryptfs/immich}

TimeoutStopSec=5min
Restart=on-failure

[Install]
WantedBy=multi-user.target
