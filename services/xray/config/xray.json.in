{
  "log": {
    "loglevel": "warning",
    "access": "none"
  },
  "inbounds": [
    {
      "tag": "webproxy-in",
      "listen": "0.0.0.0",
      "port": 8080,
      "protocol": "http",
      "settings": {
        "accounts": [
          {
            "user": "${XRAY_USER}",
            "pass": "${XRAY_PASSWORD}"
          }
        ],
        "allowTransparent": false
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    },
    {
      "tag": "block",
      "protocol": "blackhole"
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      // Rules are evaluated in order; first match wins. `domain:` matches the
      // domain and all its subdomains. IP rules match the resolved destination.
      //
      // Examples to allow ONLY certain domains, insert a domain rule first and
      // change the catch-all below to "block":
      //   { "type": "field", "domain": ["domain:openrouter.ai", "domain:mistral.ai"], "outboundTag": "direct" }
      //
      // Examples to block specific destinations, insert before the catch-all:
      //   { "type": "field", "domain": ["domain:tracker.example.com"], "outboundTag": "block" }
      //   { "type": "field", "ip": ["203.0.113.0/24"], "outboundTag": "block" }
      {
        "type": "field",
        "ip": ["geoip:private"],
        "outboundTag": "block"
      },
      {
        "type": "field",
        "inboundTag": ["webproxy-in"],
        "outboundTag": "direct"
      }
    ]
  }
}
